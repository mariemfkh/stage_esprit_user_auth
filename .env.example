# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ms_auth_dev

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# TTL in seconds (900 = 15 minutes)
RATE_LIMIT_TTL=900
RATE_LIMIT_MAX=10

# ─── Login Brute-Force Protection ─────────────────────────────────────────────
# Max failed attempts before account lock
LOGIN_MAX_ATTEMPTS=5
# Lock duration in seconds (900 = 15 minutes)
LOGIN_LOCK_DURATION=900
# ─── SMTP (Email) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000

# ─── Reset Password ────────────────────────────────────────────────────────
RESET_PASSWORD_TOKEN_EXPIRATION=3600000